{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/web"],
      "port": 3000
    },
    {
      "name": "demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/web", "--", "--dotenv", ".env.demo"],
      "env": {
        "FIREBASE_API_KEY": "",
        "FIREBASE_AUTH_DOMAIN": "",
        "FIREBASE_PROJECT_ID": "",
        "FIREBASE_STORAGE_BUCKET": "",
        "FIREBASE_MESSAGING_SENDER_ID": "",
        "FIREBASE_APP_ID": ""
      },
      "port": 3100,
      "autoPort": true
    },
    {
      "name": "api",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/api"],
      "env": { "FIREBASE_PROJECT_ID": "" },
      "port": 3001
    },
    {
      "name": "mobile",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "-w", "apps/mobile"],
      "port": 8081
    }
  ]
}
