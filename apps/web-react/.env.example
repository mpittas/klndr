# Firebase web config (Firebase console > Project settings > Your apps).
# These values are public identifiers, not secrets: access is enforced by
# firestore.rules and Firebase Auth. Restrict the API key to your domains.
# Leave them empty to run without Firebase: the app then skips the auth gate and
# the API (started with `npm run dev:api`) answers as its in-memory "local-dev" user.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Show "Sign in with Apple" on the login and sign-up pages. Set it to "true" only once the Apple provider
# is configured in the Firebase console (Authentication > Sign-in method); until then the button would fail.
# VITE_ENABLE_APPLE_SIGN_IN=true

# The API's address. Leave it empty to use this origin, which is where the dev
# server proxies /api (see vite.config.ts). Set it only when the API runs elsewhere.
VITE_API_BASE_URL=

# Where the dev server's /api proxy points (default http://localhost:3001).
# VITE_API_PROXY_TARGET=http://localhost:3001
