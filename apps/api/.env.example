# Read by `npm run dev -w apps/api` and `npm start -w apps/api` (Node itself loads this file, via `--env-file-if-exists`; developed on Node 24).

# The Firebase project whose ID tokens are accepted (Firebase console > Project settings).
# Leave it empty in development to run without Firebase: every request then acts as the
# "local-dev" user, with data kept in memory. In production an empty value stops the server.
FIREBASE_PROJECT_ID=

# Port to listen on (default 3001).
PORT=3001

# Set to "production" to turn the local-dev fallback off.
NODE_ENV=development

# Lets an OpenAI model pick the emoji for new activities and categories (platform.openai.com > API keys).
# Optional: without it new items get a neutral emoji (a pin, or a folder). Keep it on the server only.
OPENAI_API_KEY=
# The model that does it; the default is a small, cheap one (gpt-5.6-luna).
# EMOJI_MODEL=gpt-5.6-luna

# Point the Firestore REST client at the local emulator instead of Google (optional).
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
