{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // "expo/types" declares the asset and CSS imports (*.css, *.png, …) that the bundler handles,
    // and the generated expo-env.d.ts that normally references it is gitignored; naming it here
    // keeps a fresh checkout typechecking. "node" is for app.config.ts, which runs under Node.
    "types": ["expo/types", "node"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
