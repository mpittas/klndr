# Copy to `.env` (gitignored) and fill in. Expo reads this file when it builds the bundle, and
# every EXPO_PUBLIC_ value is inlined into it.

# The web API, without a trailing slash. On a device, use your machine's LAN address
# (http://192.168.x.x:3000), not localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# The public website, for the privacy policy and account-deletion links. Defaults to the API base.
EXPO_PUBLIC_WEB_URL=

# The Google *web* client id from the Firebase console (used on iOS and Android too).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# 1 = skip sign-in and call the API without a token. Development only.
EXPO_PUBLIC_DEMO_MODE=0

# api (the default) or firestore (Phase 3).
EXPO_PUBLIC_DATA_MODE=api

# The Firebase native config files, absolute or relative to apps/mobile. Both are gitignored
# (google-services.json, GoogleService-Info.plist); EAS supplies them per build environment.
GOOGLE_SERVICES_JSON=./google-services.json
GOOGLE_SERVICES_INFO_PLIST=./GoogleService-Info.plist
